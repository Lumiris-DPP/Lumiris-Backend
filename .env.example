# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lumiris
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://localhost:3002,http://localhost:3003

# JWT (doit faire au minimum 256 bits)
JWT_SECRET=your_jwt_secret_key_min_256_bits_long

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@lumiris.com