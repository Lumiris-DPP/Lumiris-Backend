# Profil Spring actif (local = messages d'erreur détaillés)
SPRING_PROFILES_ACTIVE=local

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lumiris
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# Flyway: en dev, ajoute les seeds de démo (comptes/profils). En prod, laisse la valeur par défaut
# (schéma uniquement) pour ne jamais créer les comptes de démo (ex. admin@lumiris.com).
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3002,http://localhost:3003

# JWT (doit faire au minimum 256 bits)
JWT_SECRET=your_jwt_secret_key_min_256_bits_long

# === Stripe (monétisation par abonnement) ===
# Clés du dashboard Stripe (mode test : sk_test_… / pk_test_…). Jamais commit.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Secret de signature des webhooks. En local : `stripe listen --forward-to
# localhost:8080/api/stripe/webhook` affiche un whsec_… à coller ici.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Crée/synchronise les prix récurrents pour chaque produit au démarrage (idempotent).
STRIPE_BOOTSTRAP_CATALOG=true
# URL de retour après le Customer Portal / paiement.
STRIPE_PORTAL_RETURN_URL=http://localhost:3003/subscription
# Product ids Stripe (déjà créés côté dashboard).
STRIPE_PRODUCT_SOLO=prod_UmBUMIsrwQTVBn
STRIPE_PRODUCT_STUDIO=prod_UmBUw7Q3MkKFCj
STRIPE_PRODUCT_MAISON=prod_UmBVvXE0pr9y9o
STRIPE_PRODUCT_ATELIER_PLUS=prod_UmBVXIJEaDyZRq
STRIPE_PRODUCT_LOCAL=prod_UmBWkuxrYTSIqk

# === Stockage fichiers (MinIO / S3) ===
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lumiris

# === Blockchain (ancrage du hash DPP sur Ethereum Sepolia) ===
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<ta-clé-alchemy>
BLOCKCHAIN_WALLET_PRIVATE_KEY=<ta-clé-privée-hex-sans-0x>
